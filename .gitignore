.env
.env.*
!.env.example
/API.txt
/*API.txt

# Conda
.conda/
conda-bld/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

